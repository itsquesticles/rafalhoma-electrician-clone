{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Canonical tokens for the Electrician Dark Gold design system.",
  "$extensions": {
    "design-system-engine": {
      "version": "1.0.0",
      "authority": "derived-from-DESIGN.md",
      "source_chain": ["DESIGN.md", "tokens.json", "framework adapters", "runtime consumers"],
      "rules": {
        "semantic_tokens_alias_primitives": true,
        "component_tokens_alias_semantics": true,
        "state_tokens_alias_semantics_or_components": true,
        "framework_specific_values_forbidden": true
      }
    }
  },
  "color": {
    "primitive": {
      "navy": { "$type": "color", "$value": "#0A0F1E" },
      "navy-deep": { "$type": "color", "$value": "#050810" },
      "navy-card": { "$type": "color", "$value": "#0D1B2A" },
      "slate": { "$type": "color", "$value": "#1F2937" },
      "slate-strong": { "$type": "color", "$value": "#374151" },
      "gold": { "$type": "color", "$value": "#F5C518" },
      "gold-hover": { "$type": "color", "$value": "#E5B510" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "gray-300": { "$type": "color", "$value": "#D1D5DB" },
      "gray-400": { "$type": "color", "$value": "#9CA3AF" },
      "success": { "$type": "color", "$value": "#22C55E" },
      "warning": { "$type": "color", "$value": "#F59E0B" },
      "danger": { "$type": "color", "$value": "#EF4444" }
    },
    "semantic": {
      "surface": {
        "canvas": { "$value": "{color.primitive.navy}" },
        "raised": { "$value": "{color.primitive.navy-card}" },
        "inset": { "$value": "{color.primitive.slate}" }
      },
      "text": {
        "primary": { "$value": "{color.primitive.white}" },
        "secondary": { "$value": "{color.primitive.gray-300}" },
        "muted": { "$value": "{color.primitive.gray-400}" },
        "inverse": { "$value": "{color.primitive.navy}" }
      },
      "border": {
        "subtle": { "$value": "{color.primitive.slate}" },
        "default": { "$value": "{color.primitive.slate-strong}" },
        "focus": { "$value": "{color.primitive.gold}" }
      },
      "action": {
        "primary": { "$value": "{color.primitive.gold}" },
        "primary-hover": { "$value": "{color.primitive.gold-hover}" },
        "primary-foreground": { "$value": "{color.primitive.navy}" }
      },
      "status": {
        "success": { "$value": "{color.primitive.success}" },
        "warning": { "$value": "{color.primitive.warning}" },
        "danger": { "$value": "{color.primitive.danger}" }
      }
    }
  },
  "spacing": {
    "unit": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" },
    "section": { "$type": "dimension", "$value": "96px" }
    ,"scrollbar": { "$type": "dimension", "$value": "8px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "16px" },
    "scrollbar": { "$type": "dimension", "$value": "4px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "brand": { "$type": "shadow", "$value": "0 0 15px rgba(245, 197, 24, 0.1)" },
    "brand-hover": { "$type": "shadow", "$value": "0 0 20px rgba(245, 197, 24, 0.3)" }
  },
  "typography": {
    "font-family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, sans-serif" },
      "display": { "$type": "fontFamily", "$value": "Montserrat, ui-sans-serif, system-ui, sans-serif" }
    },
    "font-weight": {
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "font-size": {
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "5xl": { "$type": "dimension", "$value": "3rem" }
    },
    "line-height": {
      "tight": { "$value": 1.1 }
    }
  }
}
